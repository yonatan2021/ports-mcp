# Public canonical URL used during the static-site build.
SITE_URL=https://port-manager.example

# Optional: GA4 is loaded only after a visitor explicitly accepts analytics.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional but recommended: raises GitHub API rate limits while validating the
# latest release and its two DMG assets at build time.
GITHUB_TOKEN=github_pat_replace_me

# GitHub Actions secret used by the release workflow to trigger a Vercel deploy.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/example
